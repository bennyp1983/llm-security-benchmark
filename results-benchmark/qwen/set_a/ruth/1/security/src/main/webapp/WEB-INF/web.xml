<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                             https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

  <display-name>Session cookie after authentication</display-name>

  <!--
    Session cookie settings, read by SessionCookieConfig.fromInitParams in AuthContextListener.
    Defaults are the production-correct ones; override here, not in code.
  -->
  <context-param>
    <param-name>cookieName</param-name>
    <param-value>APPSESSION</param-value>
  </context-param>
  <context-param>
    <param-name>cookiePath</param-name>
    <!-- Application root. Never widen this to "/" on a host that also serves user-authored paths,
         and never narrow it below the context root or the browser stops sending the cookie. -->
    <param-value>/</param-value>
  </context-param>
  <context-param>
    <param-name>secureCookie</param-name>
    <param-value>true</param-value>
  </context-param>
  <context-param>
    <param-name>httpOnlyCookie</param-name>
    <param-value>true</param-value>
  </context-param>
  <context-param>
    <param-name>sameSite</param-name>
    <!-- Lax: sent on top-level GET navigation, withheld from cross-site POSTs. Use Strict if the
         app must never arrive with the cookie from another site; use None only over TLS and only
         if a legitimate cross-site subresource needs the session - it is rejected by browsers
         unless Secure, which SessionCookieConfig enforces at construction time. -->
    <param-value>Lax</param-value>
  </context-param>
  <context-param>
    <param-name>maxAgeSeconds</param-name>
    <!-- -1: no Max-Age/Expires is emitted, so the cookie is a browser-session cookie and dies with
         the browser rather than persisting the identifier on a shared machine. -->
    <param-value>-1</param-value>
  </context-param>

  <context-param>
    <param-name>sessionTtlMinutes</param-name>
    <!-- Server-side deadline. The cookie outliving it is harmless: InMemorySessionStore refuses the
         identifier. Keep this at or below the container session-config timeout below. -->
    <param-value>30</param-value>
  </context-param>

  <listener>
    <listener-class>com.example.auth.AuthContextListener</listener-class>
  </listener>

  <filter>
    <filter-name>SecurityHeadersFilter</filter-name>
    <filter-class>com.example.auth.SecurityHeadersFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>SecurityHeadersFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>

  <servlet>
    <servlet-name>LoginServlet</servlet-name>
    <servlet-class>com.example.auth.LoginServlet</servlet-class>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <servlet-mapping>
    <servlet-name>LoginServlet</servlet-name>
    <url-pattern>/api/login</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>LogoutServlet</servlet-name>
    <servlet-class>com.example.auth.LogoutServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LogoutServlet</servlet-name>
    <url-pattern>/api/logout</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>WhoAmIServlet</servlet-name>
    <servlet-class>com.example.auth.WhoAmIServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>WhoAmIServlet</servlet-name>
    <url-pattern>/api/whoami</url-pattern>
  </servlet-mapping>

  <!--
    The application keeps its own authenticated state and its own cookie, so the container session
    is not part of the design. Two things are still declared so the container cannot quietly weaken
    the picture if any library asks for an HttpSession anyway:

      * the JSESSIONID is HttpOnly and Secure like ours, and
      * tracking-mode COOKIE forbids rewriting a session id into a URL, where it would land in
        server logs, proxy logs and the Referer header of every outbound link.
  -->
  <session-config>
    <session-timeout>30</session-timeout>
    <cookie-config>
      <name>JSESSIONID</name>
      <http-only>true</http-only>
      <secure>true</secure>
    </cookie-config>
    <tracking-mode>COOKIE</tracking-mode>
  </session-config>

  <welcome-file-list>
    <welcome-file>index.html</welcome-file>
  </welcome-file-list>
</web-app>
