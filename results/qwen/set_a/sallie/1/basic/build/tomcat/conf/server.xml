<?xml version="1.0" encoding="UTF-8"?>
<Server port="8109" shutdown="SHUTDOWN">
  <Listener className="org.apache.catalina.startup.VersionLoggerListener"/>
  <Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener"/>
  <Listener className="org.apache.catalina.mbeans.GlobalResourcesLifecycleListener"/>
  <GlobalNamingResources/>
  <Service name="demo">
    <Executor name="demo" maxThreads="32" minSpareThreads="4"/>
    <Connector port="8181" protocol="HTTP/1.1" executor="demo"
               connectionTimeout="20000" redirectPort="8643"/>
    <Connector port="8643" protocol="org.apache.coyote.http11.Http11NioProtocol"
               executor="demo" SSLEnabled="true" scheme="https" secure="true">
      <SSLHostConfig>
        <Certificate certificateKeystoreFile="/data/results/qwen/set_a/sallie/1/basic/build/tomcat/demo.jks" certificateKeystorePassword="changeit"
                     type="RSA"/>
      </SSLHostConfig>
    </Connector>
    <Engine name="demo" defaultHost="localhost">
      <Host name="localhost" appBase="/data/results/qwen/set_a/sallie/1/basic/build/tomcat/webapps" unpackWARs="true" autoDeploy="true">
        <Valve className="org.apache.catalina.valves.AccessLogValve" directory="logs"
               prefix="access" suffix=".log" pattern="%h %l %u %t &quot;%r&quot; %s %b"/>
      </Host>
    </Engine>
  </Service>
</Server>
