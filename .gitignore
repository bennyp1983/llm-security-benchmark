# Real secrets -- never committed. Copy .env.example to .env and fill it in.
.env

# Local Docker build artifacts / editor cruft
*.log
.DS_Store

# Python
__pycache__/

# Rendered report output: add back at final submission only
report/docs/

# Reworking locally: re-added when the report source reaches its final form.
# requirements.txt stays tracked: Dockerfile.cyber COPYs it at build time.
report/*
!report/requirements.txt

# Python virtualenvs (any machine)
.venv*/
