# Secrets: a local .env file is never committed
.env

# Log files and macOS Finder files. Logs that are part of a generated result are
# force-added on purpose (see the README notes)
*.log
.DS_Store

# Python caches and virtual environments
__pycache__/
.venv*/

# Report: Quarto's cache and working files, and everything the cyber workflow
# generates except the final reports (markdown with its figures, and docx)
report/.quarto/
report/.gitignore
report/**/*.quarto_ipynb
report/final_report_*.qmd
report/**/*_files/
report/docs/*
!report/docs/final_report_findings.md
!report/docs/final_report_findings_files/
!report/docs/final_report_findings.docx
!report/docs/final_report_run_cost.md
!report/docs/final_report_run_cost_files/
!report/docs/final_report_run_cost.docx
