# portal.properties -- example. Copy it, do not edit this file in place.
#
#   install -m 600 config/portal.properties.example /etc/portal/portal.properties
#   export PORTAL_CONFIG=/etc/portal/portal.properties
#
# The mode is not a suggestion: PortalConfig refuses to start if the file is readable or
# writable by group or other (`config-readable-by-group-or-other`), if it is a symlink
# (`config-symlink-refused`), or if its directory is world-writable
# (`config-dir-world-writable`). 0600 owned by the service account is the only mode that
# loads. The file is read at most 16 KiB; a larger file is refused rather than truncated.
#
# Nothing here is a secret. The keystore password is read from a separate file named by an
# environment variable, so it never lives in a file that gets copied, backed up or diffed.
# Do not add a password, a token or a private key to this file: the loader does not know
# what a secret looks like and will happily echo the KEY back in a startup error.
#
# Syntax note (documented, not worked around): this is read with java.util.Properties, so a
# value loses leading whitespace but keeps trailing whitespace, and `\` introduces an escape.
# A host or CIDR written as ` portal.listen.host = 127.0.0.1 ` therefore means the literal
# `127.0.0.1 `, and the trailing space makes it invalid -- which is refused, not repaired.
# Write one key per line, no spaces around `=`, no trailing blanks.

# PBKDF2 iterations per password record. Records below the floor refuse to load, so raising
# this later upgrades new writes without breaking old ones; lowering it below 100000 stops
# the program from starting at all. Cost is linear in the iteration count: measured on an
# idle instance of this machine, 100000 is ~165 ms per derivation, 150000 ~215 ms, 500000
# ~712 ms, 2000000 ~2.85 s. Every login does exactly one derivation, so this number is also
# the floor on login latency -- raise it with the CPU budget of the host, not past it.
portal.kdf.iterations = 150000

# Bind address. Must be a numeric literal -- a hostname is refused
# (`startup-refused reason=config-listen-host-must-be-literal`) so startup cannot be made to
# depend on DNS, and a hostname cannot quietly become 0.0.0.0
# when the name resolves to more than one address. Use 0.0.0.0 to serve every interface.
portal.listen.host = 127.0.0.1

# 1-65535. No privileged-port binding, no port 0.
portal.listen.port = 8443

# Proxies whose X-Forwarded-For header may be believed, as a comma-separated list of CIDRs.
# Leave this EMPTY unless the portal really is behind a load balancer: with an empty list
# every peer address is taken from the socket, which is the safe answer.
#
# IPv4 ranges only. An IPv6 range such as fd00::/8 is refused at startup
# (`startup-refused reason=cidr-shape`), not silently ignored -- that refusal is deliberate
# and worth knowing before you configure
# an IPv6 load balancer, because the alternative (accepting a range the matcher cannot
# evaluate) would make per-source throttling spoofable. An IPv6 *peer address* is still
# parsed and hashed normally; it simply cannot be named as a trusted range, so on an IPv6
# front end leave this empty and accept that X-Forwarded-For is not believed.
#
# Each entry must be dotted-quad/prefix, the prefix 0-32 written with plain ASCII digits
# (no leading zero, no '+', no space), and the whole list is validated at startup so a typo
# cannot silently disable per-source throttling mid-attack.
# Example for a load balancer on 10.0.0.7 in the same rack:
# portal.trusted.proxy.cidrs = 10.0.0.7/32
portal.trusted.proxy.cidrs =

# HSTS max-age in seconds, 0-31536000 (one year). Sent on every response over TLS. 0 sends
# no header, which is only appropriate while testing; anything shorter than a week does not
# survive a browser restart.
portal.hsts.max.age.seconds = 31536000

# --------------------------------------------------------------------------- environment
#
# These have no property-file equivalent because they name files outside this file's
# reach, and two of them name a secret. Set them in the service unit or the shell that
# starts the process -- never on the command line, where they land in `ps` output and in
# every accounting log that records execve.
#
#   PORTAL_DATA_DIR                required. Owner-private 0700 directory holding
#                                  employees.dat, audit.log, throttle.log. Must be an
#                                  absolute path with no ".." segment; startup refuses
#                                  to create or open it if it is not private, and refuses
#                                  to descend through a world-writable ancestor.
#   PORTAL_CONFIG                  absolute path to this file (see the mode rules above).
#   PORTAL_KEYSTORE                absolute path to a PKCS12 keystore, 0600. Required to
#                                  run `portal`; there is deliberately no plaintext HTTP
#                                  fallback (`https-keystore-not-configured`).
#   PORTAL_KEYSTORE_PASSWORD_FILE   absolute path to a one-line file holding the keystore
#                                  password, 0600, <=512 bytes, no control characters.
#                                  PORTAL_KEYSTORE and this must be supplied together --
#                                  a keystore with no password file is refused rather than
#                                  tried with an empty password. tools/gen-cert.sh writes
#                                  it and prints a random one; it is never typed, stored in
#                                  this file, or printed by the portal.
#
# Values are checked for type, length, allowed characters and range at load time. Every
# refusal names the key and a machine token; none of them prints the value it rejected.
