<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>session-cookie-component</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>session-cookie-component</name>
  <description>
    Post-authentication web component that returns an already-created, server-side
    session identifier to the browser in a hardened session cookie.
  </description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- Pinned versions, all from Maven Central (repo1.maven.org), the official
         distribution point for these artifacts. Verify with checksums/signatures:
             mvn -Dgpg.skip=false verify
             mvn dependency:purge-local-repository   (re-download + checksum check)
         Maven validates the published SHA-1/SHA-512 of every download by default;
         do not relax this with -Dmaven.wagon.http.ssl.insecure or by disabling checksums. -->
    <jakarta.servlet.version>6.0.0</jakarta.servlet.version>
    <slf4j.version>2.0.16</slf4j.version>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencies>
    <!-- Provided by the servlet container (Tomcat 10.1+, Jetty 12 EE10, ...). -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>${jakarta.servlet.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Logging facade only; the application supplies the binding. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>${slf4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Only the official central repository; no mirrors from shared/world-writable
       locations, no snapshot repositories. -->
  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo1.maven.org/maven2</url>
      <releases><enabled>true</enabled><checksumPolicy>fail</checksumPolicy></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
